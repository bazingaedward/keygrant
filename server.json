{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.bazingaedward/keygrant",
  "title": "keygrant",
  "description": "Run commands with API keys injected per call — values never enter model context.",
  "websiteUrl": "https://keygrant.app",
  "repository": {
    "url": "https://github.com/bazingaedward/keygrant",
    "source": "github"
  },
  "version": "0.1.3",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "keygrant",
      "version": "0.1.3",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
